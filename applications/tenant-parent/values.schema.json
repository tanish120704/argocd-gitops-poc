{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "tenantId",
    "groups"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 46,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "groups": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "groupPrune": {
      "type": "boolean"
    },
    "tenantValuesPath": {
      "type": "string",
      "pattern": "^$|^[a-zA-Z0-9_-]+(/[a-zA-Z0-9_.-]+)*[.]yaml$"
    }
  }
}
