{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "tenantId",
    "groups"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 46,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "groups": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "groupPrune": {
      "type": "boolean"
    },
    "chartsRevision": {
      "type": "string",
      "minLength": 1
    },
    "valuesRevision": {
      "type": "string",
      "minLength": 1
    },
    "groupChartsRevisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foundation": {
          "type": "string",
          "minLength": 1
        },
        "core-platform": {
          "type": "string",
          "minLength": 1
        },
        "product-services": {
          "type": "string",
          "minLength": 1
        },
        "to-revisit": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
